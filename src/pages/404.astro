---
import Base from '../layouts/Base.astro';
import ArrowLink from '../components/ArrowLink.astro';
import { links } from '../config/site';
---
<Base title="Page not found" noindex>
  <section class="nf">
    <div class="wrap">
      <p class="label">404</p>
      <h1 class="h1">This page doesn’t exist.</h1>
      <p class="lede">The link may be out of date, or the page may have moved.</p>
      <ul class="nf__links" role="list">
        <li><ArrowLink href="/">Home</ArrowLink></li>
        <li><ArrowLink href="/models/">Models</ArrowLink></li>
        <li><ArrowLink href="/pricing/">Pricing</ArrowLink></li>
        <li><ArrowLink href={links.docs} external>Documentation</ArrowLink></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(4rem, 2rem + 8vw, 10rem);
  }
  .nf .wrap {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 1rem;
  }
</style>
