---
/**
 * Hero exhibit: one request, and the itemised usage it produces.
 * Switching the model re-prices the same request from catalog rates,
 * which shows both "one API" and "transparent pricing" in one place.
 */
import Logo from './Logo.astro';
import type { Model } from '../lib/catalog';

interface Props {
  models: Model[];
}

const PREFERRED = ['claude-sonnet-5-5', 'gpt-6.1-sol', 'gemini-3.8-flash', 'deepseek-v4.1-flash'];

// The example workload: a long, cacheable document plus a short question.
const BASE = { cached: 48_200, input: 2_310, output: 1_180 };
// Tokenizers differ between model families, so counts differ slightly too.
const TOKENIZER: Record<string, number> = { openai: 1, anthropic: 1.06, google: 0.97, deepseek: 1.03 };
const BALANCE = 250;

const { models } = Astro.props;

let picks = PREFERRED.map((id) => models.find((m) => m.id === id)).filter(Boolean) as Model[];
if (picks.length < 2) {
  const seen = new Set<string>();
  picks = models.filter((m) => !seen.has(m.provider.id) && seen.add(m.provider.id)).slice(0, 4);
}

const usd = (n: number, d = 4) => `$${n.toFixed(d)}`;
const int = (n: number) => n.toLocaleString('en-US');
const rate = (n: number) => `$${n.toFixed(Math.round(n * 1000) % 10 !== 0 ? 3 : 2)}`;

const rows = picks.map((m) => {
  const f = TOKENIZER[m.provider.id] ?? 1;
  const cachedTokens = Math.round(BASE.cached * f);
  const inputTokens = Math.round(BASE.input * f);
  const outputTokens = BASE.output;
  const cachedRate = m.pricing.cachedInput ?? m.pricing.input;
  const lines = [
    { key: 'input', label: 'Input', tokens: inputTokens, rate: m.pricing.input },
    { key: 'cached', label: m.pricing.cachedInput === null ? 'Input (not cached)' : 'Cached input', tokens: cachedTokens, rate: cachedRate },
    { key: 'output', label: 'Output', tokens: outputTokens, rate: m.pricing.output },
  ].map((l) => ({ ...l, cost: (l.tokens * l.rate) / 1_000_000 }));
  const total = lines.reduce((s, l) => s + l.cost, 0);
  return {
    id: m.id,
    provider: m.provider.name,
    lines: lines.map((l) => ({
      key: l.key,
      label: l.label,
      detail: `${int(l.tokens)} tokens × ${rate(l.rate)} / 1M`,
      cost: usd(l.cost),
    })),
    total: usd(total),
    balance: `${usd(BALANCE, 2)} → ${usd(BALANCE - total, 2)}`,
  };
});

const first = rows[0];
---
<figure class="exhibit" data-exhibit data-rows={JSON.stringify(rows)}>
  <fieldset class="exhibit__switch" data-requires-js>
    <legend class="exhibit__legend">Same request, another model</legend>
    <div class="exhibit__options">
      {rows.map((r, i) => (
        <label class="exhibit__option">
          <input type="radio" name="exhibit-model" value={r.id} checked={i === 0} />
          <span>{r.provider}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="exhibit__stage">
    <div class="req">
      <p class="req__line">
        <span class="req__method">POST</span>
        <span>api.gabnode.com/v1/chat/completions</span>
      </p>
      <pre class="req__body"><code>&#123;
  <span class="k">"model"</span>: <span class="s">"<mark data-field="model">{first.id}</mark>"</span>,
  <span class="k">"messages"</span>: [
    &#123; <span class="k">"role"</span>: <span class="s">"system"</span>,
      <span class="k">"content"</span>: <span class="c">&lt;policy manual&gt;</span> &#125;,
    &#123; <span class="k">"role"</span>: <span class="s">"user"</span>,
      <span class="k">"content"</span>: <span class="s">"Can I switch plans?"</span> &#125;
  ]
&#125;</code></pre>
      <div class="req__resp">
        <p class="req__resp-label">Response</p>
        <p>Yes. Plan changes take effect immediately, and the remaining days of the current cycle are credited
          to the new plan (section 4.2)…</p>
      </div>
    </div>

    <div class="receipt" aria-live="polite">
      <div class="receipt__head">
        <Logo title="Gabnode" />
        <span>Usage</span>
      </div>
      <dl class="receipt__model">
        <dt>Model</dt>
        <dd class="model-id" data-field="model">{first.id}</dd>
      </dl>
      <dl class="receipt__lines">
        {first.lines.map((l) => (
          <div class="receipt__line" data-line={l.key}>
            <dt>
              <span data-field="label">{l.label}</span>
              <small data-field="detail">{l.detail}</small>
            </dt>
            <dd class="num" data-field="cost">{l.cost}</dd>
          </div>
        ))}
      </dl>
      <dl class="receipt__total">
        <div>
          <dt>Charged</dt>
          <dd class="num" data-field="total">{first.total}</dd>
        </div>
        <div class="receipt__balance">
          <dt>Balance</dt>
          <dd class="num" data-field="balance">{first.balance}</dd>
        </div>
      </dl>
    </div>
  </div>

  <figcaption class="exhibit__caption">
    Illustrative request priced at current catalog rates. Token counts vary slightly between model families.
  </figcaption>
</figure>

<script>
  type Row = {
    id: string;
    lines: { key: string; label: string; detail: string; cost: string }[];
    total: string;
    balance: string;
  };

  for (const fig of document.querySelectorAll<HTMLElement>('[data-exhibit]')) {
    const rows: Row[] = JSON.parse(fig.dataset.rows || '[]');
    const set = (root: ParentNode, field: string, value: string) =>
      root.querySelectorAll(`[data-field="${field}"]`).forEach((el) => (el.textContent = value));

    fig.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      const row = rows.find((r) => r.id === input.value);
      if (!row) return;
      const receipt = fig.querySelector<HTMLElement>('.receipt')!;
      fig.querySelectorAll('[data-field="model"]').forEach((el) => (el.textContent = row.id));
      for (const line of row.lines) {
        const el = fig.querySelector(`[data-line="${line.key}"]`);
        if (!el) continue;
        set(el, 'label', line.label);
        set(el, 'detail', line.detail);
        set(el, 'cost', line.cost);
      }
      set(receipt, 'total', row.total);
      set(receipt, 'balance', row.balance);
      receipt.classList.remove('is-updated');
      void receipt.offsetWidth;
      receipt.classList.add('is-updated');
    });
  }
</script>

<style>
  .exhibit {
    display: grid;
    gap: 1.25rem;
  }

  /* Model switcher */
  .exhibit__switch {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .exhibit__legend {
    padding: 0;
    margin-bottom: 0.65rem;
    font-size: var(--fs-micro);
    font-weight: 500;
    color: var(--fg-2);
  }

  .exhibit__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .exhibit__option {
    position: relative;
  }

  .exhibit__option input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .exhibit__option span {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--rule);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-2);
    transition: background-color 0.15s var(--ease), color 0.15s var(--ease), border-color 0.15s var(--ease);
  }

  .exhibit__option:hover span {
    border-color: var(--ink);
    color: var(--ink);
  }

  .exhibit__option input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .exhibit__option input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* Stage: the request, with the receipt laid over its corner */
  .exhibit__stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .req {
    grid-column: 1 / -1;
    grid-row: 1;
    padding: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    padding-bottom: 7.5rem;
    background: var(--night);
    color: var(--night-ink);
  }

  .req__line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 1rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--night-rule);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--night-ink-2);
  }

  .req__method {
    color: var(--night-ink);
    font-weight: 500;
  }

  .req__body {
    margin: 0;
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.84rem);
    line-height: 1.75;
    white-space: pre-wrap;
    color: var(--night-ink-2);
  }

  .req__body .k {
    color: var(--night-ink-2);
  }

  .req__body .s {
    color: var(--night-ink);
  }

  .req__body .c {
    color: var(--night-ink-3);
    font-style: italic;
  }

  .req__body mark {
    background: none;
    color: #fff;
    box-shadow: inset 0 -2px 0 var(--signal);
  }

  .req__resp {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--night-rule);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--night-ink);
    max-width: 30em;
  }

  .req__resp-label {
    margin-bottom: 0.35rem;
    font-size: var(--fs-micro);
    color: var(--night-ink-3);
  }

  /* Receipt */
  .receipt {
    grid-column: 3 / -1;
    grid-row: 2;
    margin-top: -5.5rem;
    margin-right: -0.25rem;
    position: relative;
    padding: 1.25rem 1.35rem 1.6rem;
    background: var(--sheet);
    color: var(--ink);
    box-shadow:
      0 1px 0 rgba(20, 20, 19, 0.06),
      0 12px 32px -12px rgba(20, 20, 19, 0.28);
    font-size: 0.9375rem;
  }

  /* Torn edge */
  .receipt::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 8px;
    background:
      linear-gradient(-45deg, transparent 5px, var(--sheet) 0) 0 0 / 10px 8px repeat-x,
      linear-gradient(45deg, transparent 5px, var(--sheet) 0) 0 0 / 10px 8px repeat-x;
  }

  .receipt__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--ink);
    font-size: var(--fs-micro);
    font-weight: 500;
    color: var(--ink-2);
  }

  .receipt__head :global(.logo) {
    height: 1rem;
  }

  .receipt dl > div,
  .receipt__model {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .receipt dd {
    margin: 0;
  }

  .receipt__model {
    padding-block: 0.8rem;
    border-bottom: 1px dashed var(--rule);
  }

  .receipt__model dt {
    color: var(--ink-2);
  }

  .receipt__model .model-id {
    color: var(--ink);
    text-align: right;
  }

  .receipt__lines {
    padding-block: 0.35rem;
    border-bottom: 1px dashed var(--rule);
  }

  .receipt__line {
    padding-block: 0.55rem;
  }

  .receipt__line dt {
    display: grid;
    gap: 0.1rem;
  }

  .receipt__line small {
    font-size: var(--fs-micro);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .receipt__total {
    padding-top: 0.8rem;
    display: grid;
    gap: 0.35rem;
  }

  .receipt__total > div:first-child {
    font-weight: 620;
    font-size: 1.0625rem;
  }

  .receipt__balance {
    font-size: var(--fs-micro);
    color: var(--ink-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .receipt.is-updated [data-field] {
      animation: tick 0.35s var(--ease);
    }
    @keyframes tick {
      from {
        opacity: 0.25;
      }
    }
  }

  .exhibit__caption {
    font-size: var(--fs-micro);
    color: var(--fg-3);
    max-width: 40em;
  }

  @media (min-width: 560px) {
    .req {
      grid-column: 1 / span 8;
      padding-right: calc(100% / 8 + 1.25rem);
      padding-bottom: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    }
    .receipt {
      grid-column: 8 / -1;
      grid-row: 1;
      align-self: start;
      margin-top: 3.5rem;
      margin-right: 0;
    }
    .exhibit__caption {
      margin-top: 0.75rem;
    }
  }
</style>
