---
/**
 * Hero illustration: one example request, and the usage receipt it would
 * produce. Switching the model re-prices the same request from catalog
 * rates, which shows "one API" and "transparent pricing" together.
 * It is an illustration, labelled as such; nothing here is live activity.
 */
import Logo from './Logo.astro';
import SampleNotice from './SampleNotice.astro';
import type { Catalog } from '../lib/catalog-schema';
import { pickExampleModels, priceExample } from '../lib/receipt';

interface Props {
  catalog: Catalog;
}

const { catalog } = Astro.props;
const rows = pickExampleModels(catalog.models).map(priceExample);
const first = rows[0];
const rateWord = catalog.source === 'sample' ? 'sample' : 'published';
---
{first && (
<figure class="exhibit" data-exhibit data-rows={JSON.stringify(rows)} aria-labelledby="exhibit-caption">
  <fieldset class="exhibit__switch" data-requires-js>
    <legend class="exhibit__legend">Price this request on</legend>
    <div class="exhibit__options">
      {rows.map((r, i) => (
        <label class="exhibit__option">
          <input type="radio" name="exhibit-model" value={r.id} checked={i === 0} />
          <span>{r.provider}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="exhibit__stage">
    <div class="req">
      <p class="req__line">
        <span class="req__tag">Example request</span>
        <span><span class="req__method">POST</span> /v1/chat/completions</span>
      </p>
      <pre class="req__body" aria-label="Example request body"><code>&#123;
  <span class="k">"model"</span>: <span class="s">"<mark data-field="model">{first.id}</mark>"</span>,
  <span class="k">"messages"</span>: [
    &#123; <span class="k">"role"</span>: <span class="s">"system"</span>,
      <span class="k">"content"</span>: <span class="c">&lt;48k-token policy manual&gt;</span> &#125;,
    &#123; <span class="k">"role"</span>: <span class="s">"user"</span>,
      <span class="k">"content"</span>: <span class="s">"Can I switch plans?"</span> &#125;
  ]
&#125;</code></pre>
      <div class="req__resp">
        <p class="req__resp-label">Response</p>
        <p>Yes. Plan changes take effect immediately, and the rest of the current cycle is credited to the new
          plan (section 4.2)…</p>
      </div>
    </div>

    <div class="receipt">
      <div class="receipt__head">
        <Logo title="Gabnode" />
        <span>Usage for this request</span>
      </div>
      <dl class="receipt__model">
        <dt>Model</dt>
        <dd class="model-id" data-field="model">{first.id}</dd>
      </dl>
      <dl class="receipt__lines">
        {first.lines.map((l) => (
          <div class="receipt__line" data-line={l.key}>
            <dt>
              <span>{l.label}</span>
              <small data-field="detail">{l.detail}</small>
            </dt>
            <dd class="num" data-field="cost" data-value={l.cost}>{l.costText}</dd>
          </div>
        ))}
      </dl>
      <dl class="receipt__total">
        <div>
          <dt>Charged to balance</dt>
          <dd class="num" data-field="total" data-value={first.total}>{first.totalText}</dd>
        </div>
        <div class="receipt__balance">
          <dt>Example balance</dt>
          <dd class="num">{first.balanceBefore} → <span data-field="after" data-value={250 - first.total}>{first.balanceAfter}</span></dd>
        </div>
      </dl>
      <SampleNotice source={catalog.source} variant="inline" class="receipt__stamp" />
    </div>
  </div>

  <p class="visually-hidden" aria-live="polite" data-announce></p>

  <figcaption id="exhibit-caption" class="exhibit__caption">
    Illustration, not live account activity. The same example request is priced at {rateWord} rates for each model,
    with token counts held constant; real counts vary by model.
  </figcaption>
</figure>
)}

<script>
  import { formatUsd, formatUsdPrecise } from '../lib/format';
  import { motion, tweenNumber, warmGsap } from '../scripts/motion';
  import { EXAMPLE_BALANCE, type ReceiptRow } from '../lib/receipt';

  for (const fig of document.querySelectorAll<HTMLElement>('[data-exhibit]')) {
    const rows: ReceiptRow[] = JSON.parse(fig.dataset.rows || '[]');
    const announce = fig.querySelector<HTMLElement>('[data-announce]')!;
    warmGsap();

    fig.addEventListener('change', (e) => {
      const row = rows.find((r) => r.id === (e.target as HTMLInputElement).value);
      if (!row) return;
      const g = motion();

      const idEls = fig.querySelectorAll<HTMLElement>('[data-field="model"]');
      idEls.forEach((el) => (el.textContent = row.id));

      const details: HTMLElement[] = [];
      for (const line of row.lines) {
        const el = fig.querySelector<HTMLElement>(`[data-line="${line.key}"]`);
        if (!el) continue;
        const detail = el.querySelector<HTMLElement>('[data-field="detail"]')!;
        detail.textContent = line.detail;
        details.push(detail);
        tweenNumber(el.querySelector<HTMLElement>('[data-field="cost"]')!, line.cost, formatUsdPrecise);
      }
      tweenNumber(fig.querySelector<HTMLElement>('[data-field="total"]')!, row.total, formatUsdPrecise, 0.55);
      tweenNumber(fig.querySelector<HTMLElement>('[data-field="after"]')!, EXAMPLE_BALANCE - row.total, formatUsd, 0.55);

      // One short, orchestrated beat: the model id is re-set in the request
      // and on the receipt, then the line details settle in order.
      if (g) {
        g.killTweensOf([...idEls, ...details]);
        g.timeline()
          .fromTo(idEls, { opacity: 0.2 }, { opacity: 1, duration: 0.3, ease: 'power1.out' })
          .fromTo(details, { opacity: 0, y: 3 }, { opacity: 1, y: 0, duration: 0.3, stagger: 0.05, ease: 'power2.out', clearProps: 'transform' }, '<0.05');
      }

      announce.textContent = `${row.id}: this example request is charged ${row.totalText}.`;
    });
  }
</script>

<style>
  .exhibit {
    display: grid;
    gap: 1.25rem;
  }

  /* Model switcher */
  .exhibit__switch {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .exhibit__legend {
    padding: 0;
    margin-bottom: 0.65rem;
    font-size: var(--fs-micro);
    font-weight: 500;
    color: var(--fg-2);
  }

  .exhibit__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .exhibit__option {
    position: relative;
  }

  .exhibit__option input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .exhibit__option span {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--rule);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-2);
    transition: background-color 0.15s var(--ease), color 0.15s var(--ease), border-color 0.15s var(--ease);
  }

  .exhibit__option:hover span {
    border-color: var(--ink);
    color: var(--ink);
  }

  .exhibit__option input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .exhibit__option input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* Stage: the request, with the receipt laid over its corner */
  .exhibit__stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .req {
    grid-column: 1 / -1;
    grid-row: 1;
    padding: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    padding-bottom: 7.5rem;
    background: var(--night);
    color: var(--night-ink);
  }

  .req__line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
    padding-bottom: 1rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--night-rule);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--night-ink-2);
  }

  .req__method {
    color: var(--night-ink);
    font-weight: 500;
  }

  .req__tag {
    font-family: var(--font-sans);
    font-size: var(--fs-micro);
    font-weight: 500;
    color: var(--night-ink);
  }

  .req__body {
    margin: 0;
    font-size: clamp(0.78rem, 0.72rem + 0.2vw, 0.875rem);
    line-height: 1.7;
    white-space: pre-wrap;
    color: var(--night-ink-2);
  }

  .req__body .k {
    color: var(--night-ink-2);
  }

  .req__body .s {
    color: var(--night-ink);
  }

  .req__body .c {
    color: var(--night-ink-3);
    font-style: italic;
  }

  .req__body mark {
    background: none;
    color: #fff;
    box-shadow: inset 0 -2px 0 var(--signal);
  }

  .req__resp {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--night-rule);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--night-ink);
    max-width: 30em;
  }

  .req__resp-label {
    margin-bottom: 0.35rem;
    font-size: var(--fs-micro);
    color: var(--night-ink-3);
  }

  /* Receipt */
  .receipt {
    grid-column: 3 / -1;
    grid-row: 2;
    margin-top: -5.5rem;
    margin-right: -0.25rem;
    position: relative;
    padding: 1.25rem 1.35rem 1.6rem;
    background: var(--sheet);
    color: var(--ink);
    box-shadow:
      0 1px 0 rgba(20, 20, 19, 0.06),
      0 12px 32px -12px rgba(20, 20, 19, 0.28);
    font-size: 0.9375rem;
  }

  /* Torn edge */
  .receipt::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 8px;
    background:
      linear-gradient(-45deg, transparent 5px, var(--sheet) 0) 0 0 / 10px 8px repeat-x,
      linear-gradient(45deg, transparent 5px, var(--sheet) 0) 0 0 / 10px 8px repeat-x;
  }

  .receipt__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--ink);
    font-size: var(--fs-micro);
    font-weight: 500;
    color: var(--ink-2);
  }

  .receipt :global(.receipt__stamp) {
    margin-top: 0.9rem;
  }

  .receipt__head :global(.logo) {
    height: 1rem;
  }

  .receipt dl > div,
  .receipt__model {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .receipt dd {
    margin: 0;
  }

  .receipt__model {
    padding-block: 0.8rem;
    border-bottom: 1px dashed var(--rule);
  }

  .receipt__model dt {
    color: var(--ink-2);
  }

  .receipt__model .model-id {
    color: var(--ink);
    text-align: right;
  }

  .receipt__lines {
    padding-block: 0.35rem;
    border-bottom: 1px dashed var(--rule);
  }

  .receipt__line {
    padding-block: 0.55rem;
  }

  .receipt__line dt {
    display: grid;
    gap: 0.1rem;
  }

  .receipt__line small {
    font-size: var(--fs-micro);
    color: var(--ink-3);
  }

  .receipt__total {
    padding-top: 0.8rem;
    display: grid;
    gap: 0.35rem;
  }

  .receipt__total > div:first-child {
    font-weight: 620;
    font-size: 1.0625rem;
  }

  .receipt__balance {
    font-size: var(--fs-micro);
    color: var(--ink-2);
  }

  .exhibit__caption {
    font-size: var(--fs-micro);
    color: var(--fg-3);
    max-width: 40em;
  }

  @media (min-width: 560px) {
    .req {
      grid-column: 1 / span 8;
      padding-right: calc(100% / 8 + 1.25rem);
      padding-bottom: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    }
    .receipt {
      grid-column: 8 / -1;
      grid-row: 1;
      align-self: start;
      margin-top: 1.75rem;
      margin-right: 0;
    }
    .exhibit__caption {
      margin-top: 0.75rem;
    }
  }
</style>
