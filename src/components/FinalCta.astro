---
import ArrowLink from './ArrowLink.astro';
import { links } from '../config/site';

interface Props {
  title?: string;
}
const { title = 'One account.\nOne balance.\nOne API.' } = Astro.props;
---
<section class="cta theme-night" aria-labelledby="cta-title">
  <div class="wrap grid">
    <h2 id="cta-title" class="cta__title display">{title}</h2>
    <div class="cta__body">
      <p class="lede">
        Create an account, add balance and make your first request with the client you already use.
      </p>
      <div class="actions">
        <a class="btn" href={links.signup}>Get started</a>
        <ArrowLink href={links.docs} external>Read the documentation</ArrowLink>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(5rem, 3rem + 8vw, 10rem);
  }

  .cta__title {
    grid-column: 1 / -1;
    font-size: clamp(2.75rem, 1.2rem + 6vw, 7rem);
    max-width: 11em;
    white-space: pre-line;
  }

  .cta__body {
    grid-column: 1 / -1;
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  @media (min-width: 960px) {
    .cta__body {
      grid-column: 7 / -1;
    }
  }
</style>
